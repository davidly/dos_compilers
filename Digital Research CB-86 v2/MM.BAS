10 REM BYTE MAGAZINE OCTOBER 1982. JERRY POURNELLE. MATRIX MULTIPLY.
15 REM A AND B HOLD SMALL WHOLE NUMBERS, SO THE SUM IS EXACTLY 465880
50 SUM = 0
60 GOSUB 150
70 GOSUB 200
80 GOSUB 280
90 GOSUB 360
100 GOSUB 440
110 GOSUB 540
120 PRINT "SUM = ";SUM
140 GOTO 9999
150 REM DIMENSION
160 DIM A(20,20)
170 DIM B(20,20)
180 DIM C(20,20)
190 RETURN
200 REM FILL A
210 FOR I% = 1 TO 20
220 FOR J% = 1 TO 20
230 A(I%,J%) = I% + J%
240 NEXT J%
250 NEXT I%
260 RETURN
280 REM FILL B
290 FOR I% = 1 TO 20
300 FOR J% = 1 TO 20
310 B(I%,J%) = INT((I%+J%)/J%)
320 NEXT J%
330 NEXT I%
340 RETURN
360 REM FILL C
370 FOR I% = 1 TO 20
380 FOR J% = 1 TO 20
390 C(I%,J%) = 0
400 NEXT J%
410 NEXT I%
420 RETURN
440 REM MULTIPLY
450 FOR I% = 1 TO 20
460 FOR J% = 1 TO 20
470 FOR K% = 1 TO 20
480 C(I%,J%) = C(I%,J%) + A(I%,K%)*B(K%,J%)
490 NEXT K%
500 NEXT J%
510 NEXT I%
520 RETURN
540 REM SUM IT UP
550 FOR I% = 1 TO 20
560 FOR J% = 1 TO 20
570 SUM = SUM + C(I%,J%)
580 NEXT J%
590 NEXT I%
600 RETURN
9999 STOP
