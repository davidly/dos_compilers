! BYTE magazine October 1982. Jerry Pournelle. Matrix multiply.
! A and B hold small whole numbers, so the sum is exactly 465880.

dim a( 20, 20 ), b( 20, 20 ), c( 20, 20 )

let summ = 0

for i = 1 to 20
    for j = 1 to 20
        let a( i, j ) = i + j
    next j
next i

for i = 1 to 20
    for j = 1 to 20
        let b( i, j ) = int( ( i + j ) / j )
    next j
next i

for i = 1 to 20
    for j = 1 to 20
        let c( i, j ) = 0
    next j
next i

for i = 1 to 20
    for j = 1 to 20
        for k = 1 to 20
            let c( i, j ) = c( i, j ) + a( i, k ) * b( k, j )
        next k
    next j
next i

for i = 1 to 20
    for j = 1 to 20
        let summ = summ + c( i, j )
    next j
next i

print "SUM = "; summ
end
