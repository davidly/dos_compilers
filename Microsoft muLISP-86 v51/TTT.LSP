; Alpha-beta search in native muLISP: no PROG/GO or array emulation.
; Ten repetitions retain ascending move order and 64930 search nodes.
(setq board '(0 0 0 0 0 0 0 0 0) moves 0)
(defun proc0 (x) (or (and (= x (nth 1 board)) (= x (nth 2 board))) (and (= x (nth 3 board)) (= x (nth 6 board))) (and (= x (nth 4 board)) (= x (nth 8 board)))))
(defun proc1 (x) (or (and (= x (nth 0 board)) (= x (nth 2 board))) (and (= x (nth 4 board)) (= x (nth 7 board)))))
(defun proc2 (x) (or (and (= x (nth 0 board)) (= x (nth 1 board))) (and (= x (nth 5 board)) (= x (nth 8 board))) (and (= x (nth 4 board)) (= x (nth 6 board)))))
(defun proc3 (x) (or (and (= x (nth 0 board)) (= x (nth 6 board))) (and (= x (nth 4 board)) (= x (nth 5 board)))))
(defun proc4 (x) (or (and (= x (nth 1 board)) (= x (nth 7 board))) (and (= x (nth 3 board)) (= x (nth 5 board))) (and (= x (nth 0 board)) (= x (nth 8 board))) (and (= x (nth 2 board)) (= x (nth 6 board)))))
(defun proc5 (x) (or (and (= x (nth 2 board)) (= x (nth 8 board))) (and (= x (nth 3 board)) (= x (nth 4 board)))))
(defun proc6 (x) (or (and (= x (nth 0 board)) (= x (nth 3 board))) (and (= x (nth 2 board)) (= x (nth 4 board))) (and (= x (nth 7 board)) (= x (nth 8 board)))))
(defun proc7 (x) (or (and (= x (nth 1 board)) (= x (nth 4 board))) (and (= x (nth 6 board)) (= x (nth 8 board)))))
(defun proc8 (x) (or (and (= x (nth 2 board)) (= x (nth 5 board))) (and (= x (nth 0 board)) (= x (nth 4 board))) (and (= x (nth 6 board)) (= x (nth 7 board)))))
(setq procs '(proc0 proc1 proc2 proc3 proc4 proc5 proc6 proc7 proc8))
(defun mmMax (alpha beta depth move i value nextDepth tail score)
    (setq moves (add1 moves))
    ((and (> depth 3) (funcall (nth move procs) 2)) 4)
    (setq value 2 nextDepth (add1 depth) i 0 tail board)
    (loop
        ((null tail) value)
        (cond ((zerop (car tail))
            (rplaca tail 1)
            (setq score (mmMin alpha beta nextDepth i))
            (rplaca tail 0)
            (cond ((> score value) (setq value score)))))
        ((or (= value 6) (>= value beta)) value)
        (cond ((> value alpha) (setq alpha value)))
        (setq i (add1 i) tail (cdr tail))))
(defun mmMin (alpha beta depth move i value nextDepth tail score)
    (setq moves (add1 moves))
    ((and (> depth 3) (funcall (nth move procs) 1)) 6)
    ((= depth 8) 5)
    (setq value 9 nextDepth (add1 depth) i 0 tail board)
    (loop
        ((null tail) value)
        (cond ((zerop (car tail))
            (rplaca tail 2)
            (setq score (mmMax alpha beta nextDepth i))
            (rplaca tail 0)
            (cond ((< score value) (setq value score)))))
        ((or (= value 4) (<= value alpha)) value)
        (cond ((< value beta) (setq beta value)))
        (setq i (add1 i) tail (cdr tail))))
(defun runmm (position tail result)
    (setq tail (nthcdr position board))
    (rplaca tail 1)
    (setq result (mmMin 2 9 0 position))
    (rplaca tail 0)
    result)
(defun main (pass)
    (setq moves 0 pass 0)
    (loop
        ((= pass 10))
        (runmm 0)
        (runmm 1)
        (runmm 4)
        (setq pass (add1 pass)))
    (princ "moves: ") (princ moves) (terpri))
(main)
(system)
